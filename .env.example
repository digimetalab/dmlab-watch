# Server
PORT=3001
CCTV_LOG=data/app.log
# Interval polling status kamera (ms). Default 60000. Naikkan (mis. 300000) untuk hemat kuota serverless.
PROBE_INTERVAL_MS=60000

# ATCS Denpasar API
# Kredensial adalah PUBLIK (tertanam di kode klien situs resmi atcs.denpasarkota.go.id),
# tapi sengaja tidak diisi di sini agar file ini tetap bersih untuk secret scanner.
# Isi sendiri sebelum menjalankan `npm run scrape`.
ATCS_API_BASE=https://atcs.denpasarkota.go.id/api/v3/pv/ldevice
ATCS_CLIENT_ID=
ATCS_CLIENT_SECRET=

# Database (Turso / libSQL)
# Lokal: file:data/cctv.db (default). Produksi (Vercel): libsql://<db>.turso.io + token dari Turso dashboard.
TURSO_DATABASE_URL=file:data/cctv.db
TURSO_AUTH_TOKEN=
